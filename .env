# Application Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=210000gb
DB_NAME=limbe_police_cms
DB_PORT=3306

# Session Security Secret
SESSION_SECRET=limbe_police_cms_secure_session_key_2026_mps

# SMS Delivery Configuration
# Provider: 'airtel' (Airtel Malawi Notification API) or 'africastalking'
# Set SMS_ENABLED=true and fill provider credentials to enable SMS
SMS_ENABLED=true
SMS_PROVIDER=airtel
SMS_FROM=LIMBEPOLICE

# Airtel Malawi Notification API (developers.airtel.mw)
# Staging: https://openapiuat.airtel.mw  |  Production: https://openapi.airtel.mw
# client_id / client_secret come from your Airtel Developer Portal app,
# partnerCode is granted on approval (used in the notify path).
AIRTEL_BASE_URL=https://openapiuat.airtel.mw
AIRTEL_CLIENT_ID=your_airtel_client_id
AIRTEL_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_PARTNER_CODE=your_airtel_partner_code
AIRTEL_COUNTRY=MW

# Africa's Talking (only used if SMS_PROVIDER=africastalking)
SMS_API_USER=your_africastalking_username
SMS_API_KEY=your_africastalking_api_key