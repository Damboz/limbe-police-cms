<%- include('../partials/header') %>

<div class="app-wrapper">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
        <%- include('../partials/topbar') %>

        <div class="container-fluid py-4">

            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--mps-navy);">
                        <i class="bi bi-box-seam me-2 text-warning"></i>Evidence Ledger
                    </h4>
                    <p class="text-muted small mb-0">
                        <% if (role === 'Station Commander') { %>
                            Station-wide evidence oversight across all cases.
                        <% } else { %>
                            Evidence items logged against the cases assigned to you.
                        <% } %>
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/dashboard" class="btn btn-outline-navy btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                    </a>
                    <a href="/cases" class="btn btn-navy btn-sm">
                        <i class="bi bi-folder2-open me-1"></i>Case Register
                    </a>
                </div>
            </div>

            <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show small mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show small mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="row g-4">

                <div class="col-12 col-lg-4 col-xl-3 order-lg-1">
                    <div class="filter-panel">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-navy text-white py-3">
                                <h6 class="mb-0 fw-bold">
                                    <i class="bi bi-funnel-fill me-2 text-warning"></i>Filter Evidence
                                </h6>
                            </div>
                            <div class="card-body">
                                <form method="GET" action="/evidence" class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label small text-muted fw-semibold mb-1">Search</label>
                                        <input type="text" name="q" value="<%= filters.q %>" class="form-control form-control-sm" placeholder="Item #, description, location, case ref...">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small text-muted fw-semibold mb-1">Status</label>
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="">All Statuses</option>
                                            <% statusOptions.forEach(s => { %>
                                                <option value="<%= s.status %>" <%= filters.status === s.status ? 'selected' : '' %>><%= s.status %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small text-muted fw-semibold mb-1">Category</label>
                                        <select name="category" class="form-select form-select-sm">
                                            <option value="">All Categories</option>
                                            <% categories.forEach(c => { %>
                                                <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted fw-semibold mb-1">From</label>
                                        <input type="date" name="from" value="<%= filters.from %>" class="form-control form-control-sm">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted fw-semibold mb-1">To</label>
                                        <input type="date" name="to" value="<%= filters.to %>" class="form-control form-control-sm">
                                    </div>
                                    <div class="col-12 d-grid gap-2">
                                        <button type="submit" class="btn btn-navy btn-sm">
                                            <i class="bi bi-search me-1"></i>Apply Filters
                                        </button>
                                        <a href="/evidence" class="btn btn-outline-navy btn-sm">
                                            <i class="bi bi-x-lg me-1"></i>Reset
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-8 col-xl-9 order-lg-2">
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <div class="card border-0 shadow-sm p-3">
                                <div class="metric-card">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Total Evidence Items</span>
                                        <h3 class="fw-bold mb-0" style="color: var(--mps-navy);"><%= kpi.totalItems %></h3>
                                    </div>
                                    <div class="metric-icon navy"><i class="bi bi-box-seam"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="card border-0 shadow-sm p-3">
                                <div class="metric-card">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">In Locker</span>
                                        <h3 class="fw-bold mb-0" style="color: var(--mps-warning);"><%= kpi.inLocker %></h3>
                                    </div>
                                    <div class="metric-icon warning"><i class="bi bi-shield-lock"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="card border-0 shadow-sm p-3">
                                <div class="metric-card">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Released</span>
                                        <h3 class="fw-bold mb-0" style="color: var(--mps-success);"><%= kpi.released %></h3>
                                    </div>
                                    <div class="metric-icon success"><i class="bi bi-box-arrow-up-right"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="card border-0 shadow-sm p-3">
                                <div class="metric-card">
                                    <div>
                                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Cases Tracked</span>
                                        <h3 class="fw-bold mb-0" style="color: var(--mps-blue);"><%= kpi.trackedCases %></h3>
                                    </div>
                                    <div class="metric-icon blue"><i class="bi bi-folder-fill"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm">
                <div class="card-header bg-navy text-white d-flex align-items-center justify-content-between py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-clipboard-check me-2 text-warning"></i>Evidence Items
                    </h6>
                    <span class="badge bg-gold text-dark"><%= evidenceItems.length %> Shown</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Case Ref</th>
                                <th>Item</th>
                                <th>Category</th>
                                <th>Storage Location</th>
                                <th>Collected By</th>
                                <th>Collected</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (evidenceItems.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        No evidence items found.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% const statusColors = {
                                    'In Locker': { bg: 'rgba(234, 88, 12, 0.15)', color: 'rgb(194, 65, 12)' },
                                    'Released': { bg: 'rgba(22, 163, 74, 0.15)', color: 'rgb(21, 128, 61)' },
                                    'Transferred': { bg: 'rgba(37, 99, 235, 0.15)', color: 'rgb(29, 78, 216)' },
                                    'Returned': { bg: 'rgba(100, 116, 139, 0.15)', color: 'rgb(71, 85, 105)' },
                                    'Destroyed': { bg: 'rgba(220, 38, 38, 0.15)', color: 'rgb(185, 28, 28)' }
                                }; %>
                                <% evidenceItems.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <a href="/cases/<%= item.case_id %>" class="fw-bold font-monospace text-decoration-none" style="color: var(--mps-navy);">
                                                #<%= item.ob_number %>
                                            </a>
                                            <% if (item.crime_category) { %>
                                                <div><small class="text-muted"><%= item.crime_category %></small></div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="fw-semibold font-monospace small"><%= item.item_number %></span>
                                            <div class="small text-muted text-truncate" style="max-width: 220px;" title="<%= item.description %>">
                                                <%= item.description %>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border"><%= item.category %></span>
                                        </td>
                                        <td class="small">
                                            <i class="bi bi-geo-alt me-1 text-muted"></i><%= item.storage_location %>
                                        </td>
                                        <td class="small"><%= item.collected_by_name || '—' %></td>
                                        <td class="small text-nowrap">
                                            <% if (item.collected_at) { %>
                                                <%= new Date(item.collected_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                            <% } else { %>
                                                —
                                            <% } %>
                                        </td>
                                        <td>
                                            <% const st = item.status || 'In Locker'; %>
                                            <% const sc = statusColors[st] || { bg: 'rgba(100, 116, 139, 0.15)', color: 'rgb(71, 85, 105)' }; %>
                                            <span class="badge fw-semibold" style="background-color: <%= sc.bg %>; color: <%= sc.color %>;"><%= st %></span>
                                        </td>
                                        <td class="text-end">
                                            <a href="/cases/<%= item.case_id %>" class="btn btn-outline-navy btn-sm">
                                                <i class="bi bi-eye me-1"></i>View Case
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

                </div>
            </div>

        </div>

<%- include('../partials/footer') %>